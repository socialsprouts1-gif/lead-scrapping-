# Database
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/leads

# Server
PORT=3000
NODE_ENV=development

# Scraping Settings
SCRAPE_DELAY_MIN=2000
SCRAPE_DELAY_MAX=8000
MAX_WORKERS=3
REQUEST_TIMEOUT=30000

# Email Finding (optional)
HUNTER_API_KEY=your_hunter_api_key_here

# Proxies (optional, comma-separated)
PROXY_LIST=

# Logging
LOG_LEVEL=info
